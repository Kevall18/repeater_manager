{
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "repeater-manager",
          "configurations": {
            "web": "1:260511189056:web:39d504b8ba2b203d8bb7a5"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "flutter build web --release"
    ]
  },
  "firestore": {
    "indexes": "firestore.indexes.json"
  }
}
